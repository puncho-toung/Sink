// Compile-time point marker; never consumes a game entity slot.
entityDef info_lightgrid_hint {
	"editor_color" "1 1 0"
	"editor_mins" "-8 -8 -8"
	"editor_maxs" "8 8 8"
	"editor_usage" "Light-grid cell size for this area (bakeLightGrids)"
	"editor_var gridSize" "Cell size in units: x y z"
	"editor_var limit" "Optional maximum probes in this area"
	"dmapOnly" "1"
}
