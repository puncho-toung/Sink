 namespace ipl {
 
+// --------------------------------------------------------------------------------------------------------------------
+// ReflectionStats
+// --------------------------------------------------------------------------------------------------------------------
+
+// D3-Sink local patch 0002: statistics of one energy simulation (one probe of a reverb bake), with the layout of
+// IPLBakeProbeStats in phonon.h. Distances in millimetres of the scene's units (metres).
+struct ReflectionStats
+{
+    uint32_t escapedRays;           // ray paths whose cast hit nothing
+    uint32_t segments;              // wall-to-wall segments (casts that hit, at bounce 1 and later)
+    uint64_t segmentMm;             // the sum of their lengths, each rounded to a millimetre
+    uint64_t firstEscapeKey;        // smallest (ray index * 256 + bounce) of an escape; all ones: none
+    float escapeOrigin[3];          // that escape's ray
+    float escapeDirection[3];
+    uint64_t ceilingPathMm;         // shortest path at the last allowed bounce with energy left; all ones: none
+    uint32_t ceilingRays;           // rays that reached the last allowed bounce with energy left
+    uint32_t reserved0;
+
+    void reset()
+    {
+        escapedRays = 0;
+        segments = 0;
+        segmentMm = 0;
+        firstEscapeKey = ~0ull;
+        for (auto i = 0; i < 3; ++i)
+        {
+            escapeOrigin[i] = 0.0f;
+            escapeDirection[i] = 0.0f;
+        }
+        ceilingPathMm = ~0ull;
+        ceilingRays = 0;
+        reserved0 = 0;
+    }
+};
+
+static_assert(sizeof(ReflectionStats) == 64, "ReflectionStats must match IPLBakeProbeStats");
