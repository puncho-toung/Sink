+// --------------------------------------------------------------------------------------------------------------------
+// D3-Sink local patches
+// --------------------------------------------------------------------------------------------------------------------
+
+// One bit per local patch (0001 = bit 0). A patch change that changes bake output changes this value and the
+// engine's matching constant together.
+static const IPLuint32 kLocalPatchLevel = 0x1u;
+
+// the level names one layout: three bands. A build with octave bands would bake another energy field.
+static_assert(IPL_NUM_BANDS == 3 && Bands::kNumBands == 3, "iplLocalPatchLevel is valid for three bands only");
+
+extern "C" {
+
+IPLAPI IPLuint32 IPLCALL iplLocalPatchLevel(void)
+{
+#if defined(IPL_LOCAL_MEASURE)
+    return kLocalPatchLevel | 0x80000000u;
+#else
+    return kLocalPatchLevel;
+#endif
+}
+
+#if defined(IPL_LOCAL_MEASURE)
+IPLAPI void IPLCALL iplLocalSetBakeSeed(IPLuint64 seed)
+{
+    IReflectionSimulator::sLocalBakeSeed = seed;
+}
+
+IPLAPI void IPLCALL iplLocalGetFinalizeTime(IPLuint64* nanoseconds)
+{
+    if (nanoseconds)
+    {
+        *nanoseconds = IReflectionSimulator::sLocalFinalizeNanoseconds;
+    }
+}
+#endif
+
+}
